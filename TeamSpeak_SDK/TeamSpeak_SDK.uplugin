{
	"FileVersion": 3,
	"Version": 2.0,
	"FriendlyVersion": "2.0",
	"FriendlyName": "TeamSpeak Plugin",
	"Description": "Add proven, low-latency voice communication to your Unreal project. This plugin wraps the TeamSpeak SDK for Unreal Engine 5, providing Blueprint and C++ APIs for server connections, channel and identity management, and audio routing through the engine's audio mixer.",
	"Category": "Audio|Voice",
	"CreatedBy": "TeamSpeak Systems GmbH",
	"CreatedByURL": "https://www.teamspeak.com/",
	"DocsURL": "https://www.teamspeak.com/downloads",
	"MarketplaceURL": "",
	"SupportURL": "http://support.teamspeak.com/",
	"EnabledByDefault": false,
	"CanContainContent": false,
	"IsBetaVersion": false,
	"Installed": false,
	"SupportedTargetPlatforms": [
		"Win64",
		"Linux",
		"Mac",
		"Android",
		"IOS"
	],
	"Modules": [
		{
			"Name": "TeamSpeak_SDK",
			"Type": "Runtime",
			"LoadingPhase": "PostConfigInit",
			"AdditionalDependencies": [
				"AudioMixer"
			]
		}
	],
	"Plugins": [
		{
			"Name": "SoundUtilities",
			"Enabled": true
		}
	]
}